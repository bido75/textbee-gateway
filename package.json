{
  "name": "ai-comms-gateway",
  "version": "0.1.0",
  "description": "Universal AI communications gateway: MCP tools -> pluggable voice/SMS/MMS adapters (Asterisk/Kamailio PBX, TextBee, etc.)",
  "type": "module",
  "main": "dist/mcp/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e:docker": "node tests/docker-acceptance.mjs",
    "start": "node dist/mcp/server.js",
    "start:http": "node dist/http/server.js",
    "dev": "tsx watch src/mcp/server.ts",
    "dev:http": "tsx watch src/http/server.ts",
    "test:stub": "node scripts/start-stub.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.5.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "livekit-server-sdk": "^2.18.0",
    "pg": "^8.13.0",
    "ws": "^8.18.0",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
