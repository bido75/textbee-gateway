GATEWAY_CONFIG_PATH=./src/config/config.example.yaml
WEBHOOK_PORT=8787
LIVEKIT_WEBHOOK_PORT=8789
HTTP_PORT=8080
API_KEY=replace-with-a-long-random-secret
# Runtime mode is selected by GATEWAY_CONFIG_PATH; it is intentionally not
# overridden by a second environment switch.
# Required by config.example.yaml. Never substitute a demo number in live/physical modes.
CELLULAR_LINE_NUMBER=

# TextBee (https://textbee.dev) — SMS/MMS via an Android device
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_BASE_URL=https://textbee-api.giscop.com/api/v1
TEXTBEE_WEBHOOK_SIGNING_SECRET=

# Asterisk ARI (self-hosted PBX core, see docker/)
ARI_PASSWORD=
ARI_BASE_URL=http://127.0.0.1:8088
ARI_USERNAME=ai-gateway
CHAN_MOBILE_DEVICE=mobile0

# Media Engine (bidirectional audio bridge for live calls)
MEDIA_ENGINE_HOST=127.0.0.1
DEFAULT_VOICE_PROVIDER=stub

# Realtime voice model (used when voice_provider="openai")
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-10-01
OPENAI_REALTIME_VOICE=alloy

# LiveKit (self-hosted WebRTC voice, app-to-app calling)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Persistence (omit / leave unset to fall back to in-memory)
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/ai_comms_gateway
REDIS_URL=redis://localhost:6379
